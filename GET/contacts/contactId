import { getContactById } from '../services/contacts.js';  // Импортируем сервис

// Контроллер для обработки GET запроса на /contacts/:contactId
export const getContact = async (req, res) => {
  const { contactId } = req.params;  // Извлекаем контактный ID из параметров

  try {
    const contact = await getContactById(contactId);  // Получаем контакт через сервис

    if (!contact) {
      // Если контакт не найден, возвращаем ошибку 404
      return res.status(404).json({
        message: 'Contact not found',
      });
    }

    // Если контакт найден, возвращаем данные
    res.status(200).json({
      status: 200,
      message: `Successfully found contact with id ${contactId}!`,
      data: contact,
    });
  } catch (err) {
    res.status(500).json({
      status: 500,
      message: 'Failed to retrieve contact',
      error: err.message,
    });
  }
};
